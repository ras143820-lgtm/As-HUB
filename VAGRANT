function VagrantSystem:CreateESP(player)
    if player == LocalPlayer then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 255, 255)
    box.Thickness = 1.5
    box.Filled = false

    local healthBg = Drawing.new("Square")
    healthBg.Visible = false
    healthBg.Color = Color3.fromRGB(30, 30, 30)
    healthBg.Thickness = 1
    healthBg.Filled = true

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Color = Color3.fromRGB(0, 255, 0)
    healthBar.Thickness = 1
    healthBar.Filled = true

    local healthText = Drawing.new("Text")
    healthText.Visible = false
    healthText.Color = Color3.fromRGB(255, 255, 255)
    healthText.Size = 11
    healthText.Center = true
    healthText.Outline = true

    self.State.ActiveDrawings[player] = {Box = box, HealthBg = healthBg, HealthBar = healthBar, HealthText = healthText}
end

function VagrantSystem:RemoveESP(player)
    if self.State.ActiveDrawings[player] then
        pcall(function()
            self.State.ActiveDrawings[player].Box:Remove()
            self.State.ActiveDrawings[player].HealthBg:Remove()
            self.State.ActiveDrawings[player].HealthBar:Remove()
            self.State.ActiveDrawings[player].HealthText:Remove()
        end)
        self.State.ActiveDrawings[player] = nil
    end
end

function VagrantSystem:IsTeamMate(player)
    if not self.Config.Aimbot.TeamCheck then return false end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return true
    end
    return false
end

function VagrantSystem:IsVisible(targetPart)
    if not self.Config.Aimbot.WallCheck then return true end
    local origin = CurrentCamera.CFrame.Position
    local direction = targetPart.Position - origin
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterInstances = {CurrentCamera}
    if LocalPlayer.Character then
        table.insert(filterInstances, LocalPlayer.Character)
    end
    raycastParams.FilterDescendantsInstances = filterInstances
    raycastParams.IgnoreWater = true
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        if result.Instance:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

function VagrantSystem:GetClosestTarget()
    local closestHead = nil
    local shortestDistance = self.Config.Aimbot.FOV
    local screenCenter = Vector2.new(CurrentCamera.ViewportSize.X / 2, (CurrentCamera.ViewportSize.Y / 2) + self.Config.Aimbot.FOV_OffsetY)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not self:IsTeamMate(player) then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local head = player.Character:FindFirstChild("Head")

                if humanoid and humanoid.Health > 0 and head then
                    local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local distance = (screenPos2D - screenCenter).Magnitude

                        if distance < shortestDistance then
                            if self:IsVisible(head) then
                                shortestDistance = distance
                                closestHead = head
                            end
                        end
                    end
                end
            end
        end
    end
    return closestHead
end

--[========================================================================]--
--                     EXECUTION PIPELINE & RENDER                          --
--[========================================================================]--

function VagrantSystem:Run()
    self:InitializeUI()

    for _, player in ipairs(Players:GetPlayers()) do
        self:CreateESP(player)
    end
    Players.PlayerAdded:Connect(function(p) self:CreateESP(p) end)
    Players.PlayerRemoving:Connect(function(p) self:RemoveESP(p) end)

    local fpsText = Drawing.new("Text")
    fpsText.Visible = true
    fpsText.Size = 16
    fpsText.Center = true -- จัดกึ่งกลางข้อความให้อัตโนมัติ
    fpsText.Outline = true

    RunService.RenderStepped:Connect(function(dt)
        local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)

        -- FPS Pipeline (ย้ายมาไว้ตรงกลางด้านบนสุดของหน้าจอ ไม่ให้ทับปุ่ม Roblox)
        if self.Config.Visuals.ShowFPS then
            self.State.FPS.Frames = self.State.FPS.Frames + 1
            local currentTime = tick()
            if currentTime - self.State.FPS.LastTick >= 1 then
                self.State.FPS.Current = math.floor(self.State.FPS.Frames / (currentTime - self.State.FPS.LastTick))
                self.State.FPS.Frames = 0
                self.State.FPS.LastTick = currentTime
            end
            fpsText.Text = "FPS: " .. self.State.FPS.Current
            -- คำนวณตำแหน่ง X ให้อยู่กึ่งกลางหน้าจอพอดี และ Y อยู่ด้านบน (12 พิกเซลจากขอบบน)
            fpsText.Position = Vector2.new(CurrentCamera.ViewportSize.X / 2, 12)
            fpsText.Color = rainbowColor
            fpsText.Visible = true
        else
            fpsText.Visible = false
        end

        -- FOV Update
        local fovFrame = self.State.GUI.FOVFrame
        fovFrame.Size = UDim2.new(0, self.Config.Aimbot.FOV * 2, 0, self.Config.Aimbot.FOV * 2)
        fovFrame.Position = UDim2.new(0, CurrentCamera.ViewportSize.X / 2, 0, (CurrentCamera.ViewportSize.Y / 2) + self.Config.Aimbot.FOV_OffsetY)
        self.State.GUI.FOVStroke.Color = rainbowColor
        fovFrame.Visible = self.Config.Aimbot.Enabled

        -- Speed Pipeline
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if self.Config.Utility.SpeedEnabled then
                humanoid.WalkSpeed = self.Config.Utility.WalkSpeed
            else
                humanoid.WalkSpeed = 16
            end
        end

        -- Aimbot Pipeline
        if self.Config.Aimbot.Enabled then
            local currentTarget = self.State.LockedTarget
            if not currentTarget or not currentTarget.Parent or not currentTarget.Parent:FindFirstChildOfClass("Humanoid") or currentTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0 then
                self.State.LockedTarget = nil
            end

            if not self.State.LockedTarget then
                self.State.LockedTarget = self:GetClosestTarget()
            end

            local targetHead = self.State.LockedTarget
            if targetHead and self:IsVisible(targetHead) then
                local exactCFrame = CFrame.new(CurrentCamera.CFrame.Position, targetHead.Position)
                CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(exactCFrame, self.Config.Aimbot.SnapFactor)
            else
                self.State.LockedTarget = nil
            end
        else
            self.State.LockedTarget = nil
        end

        -- ESP Pipeline
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        for player, drawings in pairs(self.State.ActiveDrawings) do
            local targetChar = player.Character
            local box = drawings.Box
            local healthBg = drawings.HealthBg
            local healthBar = drawings.HealthBar
            local healthText = drawings.HealthText
            
            if self.Config.Visuals.ESPBox and targetChar and targetChar:FindFirstChild("Head") and targetChar:FindFirstChild("HumanoidRootPart") then
                local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
                local head = targetChar.Head
                local rootPart = targetChar.HumanoidRootPart

                if humanoid and humanoid.Health > 0 then
                    local distance = myRoot and (myRoot.Position - rootPart.Position).Magnitude or 9999
                    local topPos, topOnScreen = CurrentCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                    local bottomPos, bottomOnScreen = CurrentCamera:WorldToViewportPoint(head.Position - Vector3.new(0, 0.6, 0))

                    if topOnScreen or bottomOnScreen then
                        local height = math.abs(topPos.Y - bottomPos.Y)
                        local width = height
                        local posX = topPos.X - width / 2
                        local posY = topPos.Y

                        box.Size = Vector2.new(width, height)
                        box.Position = Vector2.new(posX, posY)
                        box.Color = rainbowColor
                        box.Visible = true

                        if distance > self.Config.Visuals.HideDistance then
                            local barWidth = 3
                            local barHeight = height
                            local barX = posX - barWidth - 4
                            local barY = posY

                            healthBg.Size = Vector2.new(barWidth, barHeight)
                            healthBg.Position = Vector2.new(barX, barY)
                            healthBg.Visible = true

                            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local currentBarHeight = barHeight * healthPercent
                            healthBar.Size = Vector2.new(barWidth, currentBarHeight)
                            healthBar.Position = Vector2.new(barX, barY + (barHeight - currentBarHeight))
                            healthBar.Visible = true

                            healthText.Text = math.floor(humanoid.Health) .. " HP"
                            healthText.Position = Vector2.new(topPos.X, posY - 15)
                            healthText.Visible = true
                        else
                            healthBg.Visible = false
                            healthBar.Visible = false
                            healthText.Visible = false
                        end
                    else
                        box.Visible = false
                        healthBg.Visible = false
                        healthBar.Visible = false
                        healthText.Visible = false
                    end
                else
                    box.Visible = false
                    healthBg.Visible = false
                    healthBar.Visible = false
                    healthText.Visible = false
                end
            else
                box.Visible = false
                healthBg.Visible = false
                healthBar.Visible = false
                healthText.Visible = false
            end
        end
    end)
end

-- Start Framework Execution
VagrantSystem:Run()

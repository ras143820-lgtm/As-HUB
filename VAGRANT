        WallCheck = true,
        TeamCheck = true,
        SnapFactor = 0.90 -- ความดูด 90%
    },
    Visuals = {
        ESPBox = true,
        HideDistance = 5,
        ShowFPS = true
    },
    Utility = {
        SpeedEnabled = false,
        WalkSpeed = 24
    }
}


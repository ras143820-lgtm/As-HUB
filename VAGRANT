function VagrantSystem:InitializeUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "VagrantProFramework"
    ScreenGui.ResetOnSpawn = false
    
    pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    self.State.GUI.ScreenGui = ScreenGui

    -- FOV Render Ring
    local FOVFrame = Instance.new("Frame", ScreenGui)
    FOVFrame.Name = "FOVCircle"
    FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVFrame.BackgroundTransparency = 1
    
    local FOVStroke = Instance.new("UIStroke", FOVFrame)
    FOVStroke.Thickness = 1.5
    FOVStroke.Transparency = 0.3
    
    local FOVCorners = Instance.new("UICorner", FOVFrame)
    FOVCorners.CornerRadius = UDim.new(1, 0)
    self.State.GUI.FOVFrame = FOVFrame
    self.State.GUI.FOVStroke = FOVStroke

    -- Floating Icon (Monkey)
    local ToggleButton = Instance.new("ImageButton", ScreenGui)
    ToggleButton.Name = "ToggleMenuBtn"
    ToggleButton.Size = UDim2.new(0, 50, 0, 50)
    ToggleButton.Position = UDim2.new(0.05, 0, 0.2, 0)
    ToggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    ToggleButton.Image = "rbxassetid://6031094678"
    Instance.new("UICorner", ToggleButton).CornerRadius = UDim.new(1, 0)

    -- Main Container Window
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Name = "MainContainer"
    MainFrame.Size = UDim2.new(0, 210, 0, 360)
    MainFrame.Position = UDim2.new(0.15, 0, 0.1, 0)
    MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    MainFrame.Visible = false
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    self.State.GUI.MainFrame = MainFrame

    -- Header Bar
    local TitleLabel = Instance.new("TextLabel", MainFrame)
    TitleLabel.Size = UDim2.new(1, 0, 0, 30)
    TitleLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    TitleLabel.Text = " VAGRANT PRO SYSTEM"
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextSize = 12
    TitleLabel.Font = Enum.Font.SourceSansBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", TitleLabel).CornerRadius = UDim.new(0, 8)

    -- สร้างปุ่ม Toggles หลัก
    self:CreateToggleBtn(MainFrame, "Aimbot Head (Soft)", 36, self.Config.Aimbot, "Enabled")
    self:CreateToggleBtn(MainFrame, "ESP Box & HP", 68, self.Config.Visuals, "ESPBox")
    self:CreateToggleBtn(MainFrame, "Wall Check", 100, self.Config.Aimbot, "WallCheck")
    self:CreateToggleBtn(MainFrame, "Team Check", 132, self.Config.Aimbot, "TeamCheck")
    self:CreateToggleBtn(MainFrame, "Speed Hack", 164, self.Config.Utility, "SpeedEnabled")
    self:CreateToggleBtn(MainFrame, "Show FPS", 196, self.Config.Visuals, "ShowFPS")

    -- ส่วนปุ่มปรับค่า WalkSpeed
    self:CreateSliderSection(MainFrame, "WalkSpeed: " .. self.Config.Utility.WalkSpeed, 230, function(isPlus)
        if isPlus then
            self.Config.Utility.WalkSpeed = math.clamp(self.Config.Utility.WalkSpeed + 2, 16, 100)
        else
            self.Config.Utility.WalkSpeed = math.clamp(self.Config.Utility.WalkSpeed - 2, 16, 100)
        end
        return "WalkSpeed: " .. self.Config.Utility.WalkSpeed
    end)

    -- ส่วนปุ่มปรับขนาด FOV
    self:CreateSliderSection(MainFrame, "FOV Size: " .. self.Config.Aimbot.FOV, 286, function(isPlus)
        if isPlus then
            self.Config.Aimbot.FOV = math.clamp(self.Config.Aimbot.FOV + 10, 20, 400)
        else
            self.Config.Aimbot.FOV = math.clamp(self.Config.Aimbot.FOV - 10, 20, 400)
        end
        return "FOV Size: " .. self.Config.Aimbot.FOV
    end)

    -- Event Bindings สำหรับเปิด-ปิดเมนู
    ToggleButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    self:SetupWindowDragging(ToggleButton, MainFrame, TitleLabel)
end

function VagrantSystem:CreateToggleBtn(parent, name, posY, targetTable, key, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 190, 0, 28)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Text = name .. (targetTable[key] and ": ON" or ": OFF")
    btn.TextColor3 = targetTable[key] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    btn.MouseButton1Click:Connect(function()
        targetTable[key] = not targetTable[key]
        local state = targetTable[key]
        btn.Text = name .. (state and ": ON" or ": OFF")
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        if callback then callback(state) end
    end)
end

function VagrantSystem:CreateSliderSection(parent, labelText, posY, callback)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 190, 0, 16)
    label.Position = UDim2.new(0, 10, 0, posY)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 11
    label.Font = Enum.Font.SourceSansBold
    label.TextXAlignment = Enum.TextXAlignment.Left

    local btnMinus = Instance.new("TextButton", parent)
    btnMinus.Size = UDim2.new(0, 92, 0, 18)
    btnMinus.Position = UDim2.new(0, 10, 0, posY + 18)
    btnMinus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btnMinus.Text = "-"
    btnMinus.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnMinus.TextSize = 11
    btnMinus.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btnMinus).CornerRadius = UDim.new(0, 4)

    local btnPlus = Instance.new("TextButton", parent)
    btnPlus.Size = UDim2.new(0, 92, 0, 18)
    btnPlus.Position = UDim2.new(0, 108, 0, posY + 18)
    btnPlus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btnPlus.Text = "+"
    btnPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnPlus.TextSize = 11
    btnPlus.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btnPlus).CornerRadius = UDim.new(0, 4)

    btnMinus.MouseButton1Click:Connect(function()
        label.Text = callback(false)
    end)
    btnPlus.MouseButton1Click:Connect(function()
        label.Text = callback(true)
    end)
end

function VagrantSystem:SetupWindowDragging(button, frame, header)
    local draggingBtn, dragInputBtn, dragStartBtn, startPosBtn
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingBtn = true
            dragStartBtn = input.Position
            startPosBtn = button.Position
        end
    end)
    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragInputBtn = input
        end
    end)

    local draggingFrame, dragInputFrame, dragStartFrame, startPosFrame
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingFrame = true
            dragStartFrame = input.Position
            startPosFrame = frame.Position
        end
    end)
    header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragInputFrame = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInputBtn and draggingBtn then
            local delta = input.Position - dragStartBtn
            button.Position = UDim2.new(startPosBtn.X.Scale, startPosBtn.X.Offset + delta.X, startPosBtn.Y.Scale, startPosBtn.Y.Offset + delta.Y)
        end
        if input == dragInputFrame and draggingFrame then
            local delta = input.Position - dragStartFrame
            frame.Position = UDim2.new(startPosFrame.X.Scale, startPosFrame.X.Offset + delta.X, startPosFrame.Y.Scale, startPosFrame.Y.Offset + delta.Y)
        end
    end)
end


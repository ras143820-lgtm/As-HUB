local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ลบเมนูเก่าและปุ่ม G เก่าทิ้งก่อน (ถ้ามี)
if playerGui:FindFirstChild("MyTataMenu") then
    playerGui.MyTataMenu:Destroy()
end
if playerGui:FindFirstChild("MyTataToggleBtn") then
    playerGui.MyTataToggleBtn:Destroy()
end

-- ระบบจัดการไฟล์ (บันทึกข้อมูลถาวร)
local HttpService = game:GetService("HttpService")
local HISTORY_FILE = "MyTata_History.json"
local STORAGE_FILE = "MyTata_Storage.json"

local historyList = {}
local savedScriptsList = {}

pcall(function()
    if readfile and isfile and isfile(HISTORY_FILE) then
        historyList = HttpService:JSONDecode(readfile(HISTORY_FILE))
    end
end)

pcall(function()
    if readfile and isfile and isfile(STORAGE_FILE) then
        savedScriptsList = HttpService:JSONDecode(readfile(STORAGE_FILE))
    end
end)

local function SaveData()
    pcall(function()
        if writefile then
            writefile(HISTORY_FILE, HttpService:JSONEncode(historyList))
            writefile(STORAGE_FILE, HttpService:JSONEncode(savedScriptsList))
        end
    end)
end


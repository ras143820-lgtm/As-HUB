-- 6. รันรัวๆ ความเร็ว 0.3 วินาที: OFF/ON
local b6 = CreateButton(6, "6. รันรัวๆ: OFF", Color3.fromRGB(178, 34, 34))
local isFastRunning = false
local loopTask

b6.MouseButton1Click:Connect(function()
    isFastRunning = not isFastRunning
    if isFastRunning then
        b6.Text = "6. รันรัวๆ: ON"
        b6.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
        loopTask = task.spawn(function()
            while isFastRunning do
                pcall(function()
                    loadstring(CodeBox.Text)()
                end)
                task.wait(0.3) -- ความเร็ว 0.3 วินาที
            end
        end)
    else
        b6.Text = "6. รันรัวๆ: OFF"
        b6.BackgroundColor3 = Color3.fromRGB(178, 34, 34)
        if loopTask then
            task.cancel(loopTask)
        end
    end
end)


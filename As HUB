-- ประกาศฟังก์ชันรีเฟรชล่วงหน้า
local RefreshHistoryUI, RefreshStorageUI

-- ฟังก์ชันสร้างรายการประวัติ
RefreshHistoryUI = function()
    for _, child in ipairs(HistoryFrame:GetChildren()) do
        if child:IsA("Frame") or (child:IsA("TextButton") and child ~= CloseHistoryBtn) then
            child:Destroy()
        end
    end
    for index, codeContent in ipairs(historyList) do
        local rowFrame = Instance.new("Frame")
        rowFrame.Parent = HistoryFrame
        rowFrame.Size = UDim2.new(1, 0, 0, 40)
        rowFrame.BackgroundTransparency = 1

        local itemBtn = Instance.new("TextButton")
        itemBtn.Parent = rowFrame
        itemBtn.Size = UDim2.new(1, -45, 1, 0)
        itemBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        itemBtn.TextSize = 13
        itemBtn.Font = Enum.Font.SourceSansBold
        
        local previewText = codeContent
        if #previewText > 24 then
            previewText = string.sub(previewText, 1, 24) .."..."
        end
        itemBtn.Text = "ประวัติที่ " .. index .. ": " .. previewText
        
        itemBtn.MouseButton1Click:Connect(function()
            CodeBox.Text = codeContent
            HistoryFrame.Visible = false
        end)

        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Parent = rowFrame
        deleteBtn.Position = UDim2.new(1, -40, 0, 0)
        deleteBtn.Size = UDim2.new(0, 40, 1, 0)
        deleteBtn.BackgroundColor3 = Color3.fromRGB(178, 34, 34)
        deleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        deleteBtn.TextSize = 14
        deleteBtn.Font = Enum.Font.SourceSansBold
        deleteBtn.Text = "X"

        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(historyList, index)
            SaveData()
            RefreshHistoryUI()
        end)
    end
end

-- ฟังก์ชันสร้างรายการคลังเก็บ
RefreshStorageUI = function()
    for _, child in ipairs(StorageFrame:GetChildren()) do
        if child:IsA("Frame") or (child:IsA("TextButton") and child ~= CloseStorageBtn) then
